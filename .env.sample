# --- FastERP ---------------------------------------------------------------
FASTERP_ADMIN_EMAIL=admin@fasterp.example
FASTERP_ADMIN_PASSWORD=FastERP2026$
FASTERP_SECRET=
FASTERP_PORT=5011
FASTERP_ENV_LABEL=FastERP
FASTERP_DB=

# Authoritative PostgreSQL runtime and ERP migration target. Keep credentials in
# the ignored .env or deployment secret store. Leave DB_URL blank only for the
# local SQLite fallback.
DB_URL=
DB_SCHEMA=fast_erp
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=3
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_POOL_MAX_IDLE=300
DB_APPLICATION_NAME=fasterp
FASTERP_COMPANY_CODE=DEMO-GBP

# Connector secrets are resolved only from these prefixes; they are never
# stored in migration metadata.
# SAP_B1_USERNAME=
# SAP_B1_PASSWORD=
# ERP_NEXT_API_KEY=
# ERP_NEXT_API_SECRET=

# --- AI assistant ----------------------------------------------------------
# MODEL_PROVIDER: xai | openai | anthropic | google. Slash-commands need no key.
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://erp.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://erp.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=
